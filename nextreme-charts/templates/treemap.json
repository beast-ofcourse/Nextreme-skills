{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "title": { "text": "Budget Allocation Treemap", "fontSize": 16 },
  "width": 600,
  "height": 400,
  "padding": 5,
  "data": [
    {
      "name": "tree",
      "values": [
        { "id": "root", "parent": null, "name": "Budget", "value": 0 },
        { "id": "eng", "parent": "root", "name": "Engineering", "value": 500 },
        { "id": "eng-infra", "parent": "eng", "name": "Infrastructure", "value": 200 },
        { "id": "eng-fe", "parent": "eng", "name": "Frontend", "value": 150 },
        { "id": "eng-be", "parent": "eng", "name": "Backend", "value": 150 },
        { "id": "mkt", "parent": "root", "name": "Marketing", "value": 300 },
        { "id": "mkt-digital", "parent": "mkt", "name": "Digital", "value": 150 },
        { "id": "mkt-events", "parent": "mkt", "name": "Events", "value": 100 },
        { "id": "mkt-content", "parent": "mkt", "name": "Content", "value": 50 },
        { "id": "ops", "parent": "root", "name": "Operations", "value": 200 },
        { "id": "ops-hr", "parent": "ops", "name": "HR", "value": 80 },
        { "id": "ops-fin", "parent": "ops", "name": "Finance", "value": 70 },
        { "id": "ops-legal", "parent": "ops", "name": "Legal", "value": 50 }
      ],
      "transform": [
        { "type": "treemap", "field": "value", "sort": { "field": "value", "order": "descending" }, "round": true, "padding": 2, "ratio": 1.6 }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "ordinal",
      "domain": ["Engineering", "Marketing", "Operations"],
      "range": ["#2196F3", "#FF9800", "#4CAF50"]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "x": { "field": "x0" },
          "y": { "field": "y0" },
          "x2": { "field": "x1" },
          "y2": { "field": "y1" },
          "fill": { "scale": "color", "field": "name" },
          "stroke": { "value": "white" },
          "strokeWidth": { "value": 1 }
        }
      }
    },
    {
      "type": "text",
      "from": { "data": "tree" },
      "encode": {
        "enter": {
          "x": { "field": "x0", "offset": 4 },
          "y": { "field": "y0", "offset": 14 },
          "text": { "field": "name" },
          "fontSize": { "value": 11 },
          "fill": { "value": "white" },
          "fontWeight": { "value": "bold" }
        }
      }
    }
  ]
}
